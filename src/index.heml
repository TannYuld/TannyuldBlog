<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Tannyuld - Blog</title>
    <link rel="stylesheet" href="./css/main.css">
    <link rel="apple-touch-icon" sizes="180x180" href="./media/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="./media/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="./media/favicon/favicon-16x16.png">
    <link rel="manifest" href="./media/favicon/site.webmanifest">
    <import src="./components/postList.heml" as="postlist" />
    <import src="./components/about.heml" as="about" />
    <import src="./components/post.heml" as="post" />
    <import src="./components/router.heml" as="router" />
    <import src="./components/route.heml" as="route" />
    <style>
        h2.subtitle {
            font-size: 15px;
            font-weight: normal;
            color: #999999;
            margin-top: 6px;
            margin-bottom: 20px;
        }

        hr {
            border: none;
            border-top: 1px solid #333333;
            margin-bottom: 20px;
        }

        a:hover {
            cursor: pointer;
        }
    </style>
</head>

<body>
    <var name="navigateFunc" />

    <var name="onPostClick" value="{(id) => {
        if (id >= blogPosts.value.length) {
            selectedPost.value = null;
        }else {
            selectedPost.value = blogPosts.value[id];
        }
        (navigateFunc.value)('post', `&bp=${id}`)
    }}" />

    <var name="blogPosts" value="{[]}" />
    <var name="selectedPost" value="{null}" />

    <div class="site-header">
        <span class="site-name">
            <img class="site-name-photo" src="./media/KenzouTenma.webp" />
        </span>
        <span class="site-nav">
            <a onclick="{(navigateFunc.value)('home')}">Home</a>
            <a onclick="{(navigateFunc.value)('about')}">About</a>
        </span>
    </div>

    <router navigateFunc="{navigateFunc}">
        <router:home>
            <postlist posts="{blogPosts}" onPostClick="{onPostClick}" />
        </router:home>
        <router:404>
            <h1>404 - Page Not Found</h1>
            <a onclick="{(navigateFunc.value)('home')}" class="back-link">&larr; Back to all posts</a>
        </router:404>

        <route name="post">
            <if condition="{selectedPost.value !== null}">
                <post post="{selectedPost}" goBackFunc="{() => (navigateFunc.value)('home')}" />
            </if>
            <else>
                <h1>404 - Blog Post Not Found</h1>
                <p style="margin: 10px 0 20px 0; color: #999;">The post you are looking for doesn't exist or was
                    removed.</p>
                <a onclick="{(navigateFunc.value)('home')}" class="back-link">&larr; Back to all posts</a>
            </else>
        </route>
        <route name="about">
            <about />
        </route>
    </router>

    <script async type="module">
        const { retrieveData, fetchDataIfIntegrityNotMatch } = await import('./script/shared.js');


        blogPosts.value = retrieveData();
        const queryStringInAsyncBlock = window.location.search;
        const urlParamsInAsyncBlock = new URLSearchParams(queryStringInAsyncBlock);
        const blogpost = urlParamsInAsyncBlock.get('bp');
        if (blogpost !== null && queryStringInAsyncBlock.includes('p=post')) {
            (onPostClick.value)(blogpost);
        }

        blogPosts.value = await fetchDataIfIntegrityNotMatch();
    </script>
</body>

</html>